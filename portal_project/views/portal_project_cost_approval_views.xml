<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_portal_project_cost_approval_form" model="ir.ui.view">
        <field name="name">portal.project.cost.approval.form</field>
        <field name="model">portal.project.cost.approval</field>
        <field name="arch" type="xml">
            <form string="Corte de costos">
                <header><field name="state" widget="statusbar" /></header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" /></h1></div>
                    <group>
                        <group><field name="task_id"/><field name="version"/><field name="requested_by_id"/><field name="requested_date"/></group>
                        <group><field name="currency_id"/><field name="amount_before_fee"/><field name="fee_percent"/><field name="fee_amount"/><field name="total_amount"/></group>
                    </group>
                    <notebook>
                        <page string="Detalle snapshot">
                            <field name="line_ids" readonly="1">
                                <tree>
                                    <field name="category"/><field name="date"/><field name="description"/>
                                    <field name="unit"/><field name="quantity"/><field name="unit_amount"/><field name="amount"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Aprobaciones">
                            <group>
                                <field name="supervisor_partner_id"/><field name="supervisor_approved_date"/>
                                <field name="purchase_partner_id"/><field name="purchase_approved_date"/>
                                <field name="rejected_by_id"/><field name="rejected_date"/><field name="rejection_note"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_project_task_form_cost_approval" model="ir.ui.view">
        <field name="name">project.task.form.cost.approval</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_cost_approval" type="object" string="Enviar costos a VoBo"
                    class="btn-primary" groups="project.group_project_manager"/>
            </xpath>
            <xpath expr="//page[@name='extra_info']" position="after">
                <page string="VoBo" name="cost_approvals">
                    <field name="cost_approval_ids" readonly="1">
                        <tree>
                            <field name="name"/><field name="version"/><field name="state" widget="badge"/>
                            <field name="amount_before_fee"/><field name="fee_amount"/><field name="total_amount"/>
                            <field name="currency_id" column_invisible="True"/><field name="requested_date"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
