<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pending_service_planning_import_form" model="ir.ui.view">
        <field name="name">pending.service.planning.import.form</field>
        <field name="model">pending.service.planning.import</field>
        <field name="arch" type="xml">
            <form string="Importar planeación">
                <group>
                    <field name="service_id" />
                    <field name="file_data" filename="filename" />
                    <field name="filename" invisible="1" />
                    <field name="import_mode" />
                </group>
                <div class="alert alert-info" role="alert">
                    El archivo debe conservar las hojas y encabezados de la plantilla descargada.
                    La importación se cancela completa si se encuentra cualquier error.
                </div>
                <footer>
                    <button name="action_import" type="object"
                        string="Importar planeación" class="btn-primary" />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
