<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="project_invited_visibility_project_guard_rule" model="ir.rule">
            <field name="name">Project: invited internal/portal projects require invitation</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[
                '|', '|', '|',
                    ('privacy_visibility', '!=', 'invited_internal_portal'),
                    ('message_partner_ids', 'in', [user.partner_id.id]),
                    ('collaborator_ids.partner_id', 'in', [user.partner_id.id]),
                    ('user_id', '=', user.id),
            ]</field>
        </record>

